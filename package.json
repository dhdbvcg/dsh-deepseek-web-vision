{
  "name": "dsh-deepseek-web-vision",
  "version": "0.2.0",
  "description": "Unofficial DSH plugin (fork of dsh-deepseek-web-login): use chat.deepseek.com web models as a DSH LLM provider with fixed & hardened image input (self-built multipart, upload-readiness wait, per-turn image scope), browser login capture + PoW solving + SSE streaming + prompting-based tool calls. Provider route: deepseek-web-vision",
  "private": true,
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "scripts/build.sh",
    "scripts/build.mjs",
    "scripts/prepare.mjs",
    "scripts/make-dev-copy.mjs",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "license": "Apache-2.0",
  "author": "dhdbvcg",
  "contributors": [
    "cv-superding (Ding Li) — original dsh-deepseek-web-login"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dhdbvcg/dsh-deepseek-web-vision.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis-plugin",
    "deepseek",
    "llm",
    "provider",
    "vision",
    "image-input"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepare": "node scripts/prepare.mjs"
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/react": "^19.1.16",
    "tsdown": "0.22.14",
    "typescript": "5.9.3"
  }
}
